#!/bin/bash
# 獨立程序：exit 只結束這個 Bash，父 Shell 的環境不需還原。
set -euo pipefail

MOUHONG_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mouhong"
if [[ ! -r "$MOUHONG_CONFIG_DIR/bashrc" ]]; then
  echo "找不到 $MOUHONG_CONFIG_DIR/bashrc，請先執行 Ubuntu 安裝器。" >&2
  exit 1
fi
export MOUHONG_CONFIG_DIR MOUHONG_ACTIVE=1
MOUHONG_PROFILE=computer
if [[ -r "$MOUHONG_CONFIG_DIR/profile" ]]; then
  read -r MOUHONG_PROFILE < "$MOUHONG_CONFIG_DIR/profile"
fi
case "$MOUHONG_PROFILE" in
  computer) ;;
  robot)
    # 舊終端可能仍留有 proxy_on 的環境變數；此處只清除子 Shell 的代理。
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY no_proxy NO_PROXY
    ;;
  *) echo "無效的個人環境模式：$MOUHONG_PROFILE" >&2; exit 1 ;;
esac
export MOUHONG_PROFILE
export NVIM_APPNAME=nvim-mouhong
export ZELLIJ_CONFIG_DIR="$MOUHONG_CONFIG_DIR/zellij"
export ZELLIJ_CONFIG_FILE="$ZELLIJ_CONFIG_DIR/config.kdl"
export SHELL=/bin/bash

# 不讀 ~/.profile、~/.bash_profile 或 ~/.bashrc，也不透過 BASH_ENV 載入設定。
unset BASH_ENV ENV
if [[ $# -eq 0 ]]; then
  set -- -i
fi
exec /bin/bash --noprofile --rcfile "$MOUHONG_CONFIG_DIR/bashrc" "$@"
